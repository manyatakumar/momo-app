# Copy this file to .env (same folder) and fill in what you need. Everything is optional.

# --- AI drafts in your voice ---
# Free key at https://aistudio.google.com/apikey (or paste it in-app: LinkedIn setup -> Voice & AI)
GEMINI_API_KEY=
# Leave empty to auto-pick the newest Gemini Flash model
GEMINI_MODEL=

# --- Telegram mobile sync ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
MOMO_TELEGRAM_AUTOSTART=0
WHISPER_MODEL=base

# --- Pester mode ---
MOMO_PESTER_INTERVAL_MIN=45
MOMO_PESTER_LOOKAHEAD_DAYS=3
MOMO_QUIET_START=22
MOMO_QUIET_END=8
MOMO_SYSTEM_NOTIFICATIONS=1

# --- Look ---
MOMO_SCALE=4
MOMO_CAT_GLOW=1
