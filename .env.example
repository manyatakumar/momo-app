# Copy this file to .env (same folder) and fill in what you need. Everything is optional.

# --- AI drafts in your voice ---
# auto | gemini | claude | offline
MOMO_AI_PROVIDER=auto
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# Get a key at https://console.anthropic.com. You can also paste it in-app: LinkedIn setup → Voice & AI.
ANTHROPIC_API_KEY=
MOMO_CLAUDE_MODEL=claude-opus-5-5

# --- Telegram mobile sync ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
MOMO_TELEGRAM_AUTOSTART=0
WHISPER_MODEL=base

# --- Pester mode ---
MOMO_PESTER_INTERVAL_MIN=45
MOMO_PESTER_LOOKAHEAD_DAYS=3
MOMO_QUIET_START=22
MOMO_QUIET_END=8
MOMO_SYSTEM_NOTIFICATIONS=1

# --- Look ---
MOMO_SCALE=4
MOMO_CAT_GLOW=1
